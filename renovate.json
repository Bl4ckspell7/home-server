{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "bun",
    "github-actions",
    "terraform",
    "custom.regex"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose\\.ya?ml$/",
      "/(^|/)compose\\.ya?ml$/"
    ]
  },
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)docker-compose\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n.*?:\\s*&\\S+\\s+\\S+?:(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/services/forgejo-runner/files/config\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*-\\s*\"docker:docker://[^:\"]+:(?<currentValue>[^\\s@\"]+)(@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*renovate-version:\\s*(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)[^/]+\\.container$/"],
      "matchStrings": [
        "Image=(?<depName>[^\\s@]+):(?<currentValue>[^\\s@:/]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?\\n"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Digest updates once a week, all of Monday (UTC). The scheduled workflow runs at 04:00 and starts hours late, so a narrow window was never hit.",
      "matchUpdateTypes": ["digest"],
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Renovate releases several times a day, so updating it opened a PR almost daily. Once a month, all of the 1st (UTC), as one PR.",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate",
        "renovatebot/github-action"
      ],
      "groupName": "renovate",
      "schedule": ["* * 1 * *"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/(^|/)postgres$/",
        "docker.io/postgis/postgis"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^forgejo\\.bl4ckspell\\.de\\//"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "docker.io/jellyfin/jellyfin",
        "docker.io/fnsys/dockhand",
        "docker.io/vaultwarden/server"
      ],
      "versioning": "semver"
    },
    {
      "description": "llama.cpp CPU build tags (server-bNNNNN): every build is a 'major', several a day",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "versioning": "regex:^server-b(?<major>\\d+)$",
      "schedule": ["* * * * 1"]
    },
    {
      "description": "SearXNG date tags (YYYY.M.D-<commit>): ignore the commit suffix, publishes daily",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$",
      "schedule": ["* * * * 1"]
    }
  ]
}
