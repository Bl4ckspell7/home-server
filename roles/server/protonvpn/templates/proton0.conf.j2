{{ ansible_managed | comment }}
[Interface]
# IPv4 only: IPv6 is off on this host and wg-quick fails on a v6 address.
# No DNS line: it would replace /etc/resolv.conf and bypass pi-hole.
Address = {{ protonvpn_address }}
MTU = {{ protonvpn_mtu }}
FwMark = {{ protonvpn_fwmark }}
PrivateKey = {{ protonvpn_private_key }}
# All servers in proton0.peers rank equal: each start picks one at random.
PostUp = /usr/local/sbin/protonvpn-peer pick
# Containers sit on 1500-byte bridges: clamp their TCP MSS to the tunnel MTU.
PostUp = iptables -t mangle -A FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
PostUp = iptables -t mangle -A FORWARD -i %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ protonvpn_mtu | int - 40 }}
PostDown = iptables -t mangle -D FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu || true
PostDown = iptables -t mangle -D FORWARD -i %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ protonvpn_mtu | int - 40 }} || true

[Peer]
# Placeholder, replaced by PostUp: wg-quick only installs the policy routing
# for a 0.0.0.0/0 peer. Random key, no endpoint: it never sends anything. A
# `wg syncconf` from this file puts it back (`systemctl reload` repairs that).
PublicKey = EXC5OUP3SsYhUWJwNdfgVCGNoJThts9qdeQaY9F+pTw=
AllowedIPs = 0.0.0.0/0
