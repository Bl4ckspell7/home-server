#!/bin/bash
# Auto-generated by Ansible
# Usage: jellyfin-set-permissions.sh [PATH...]
# Gives PATH (recursively, for a directory) to jellyfin. Without arguments it
# sweeps every media root (the daily catch-up timer).
#
# Ownership only, never chmod: as owner jellyfin already has rw, and chmod
# follows a symlink given as argument. Jellyfin can plant symlinks in /media,
# so nothing here may dereference one: find -P does not, chown -h does not.

set -u

if [ $# -eq 0 ]; then
    set -- {% for path in jellyfin_media_paths %}"{{ path }}" {% endfor %}

fi

for path in "$@"; do
    find "$path" ! -user jellyfin -exec chown -h jellyfin:jellyfin {} + 2>/dev/null
done
exit 0
