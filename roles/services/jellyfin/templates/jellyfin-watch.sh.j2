#!/bin/bash
# Auto-generated by Ansible
# Hands new media to jellyfin: uploads (sshfs as root) arrive root-owned, and
# Jellyfin writes metadata, subtitles and trickplay next to them. Only the new
# path is fixed, never the whole tree; -m keeps one inotifywait running. Paths
# missed while not watching (restart, a subdir created before its watch) are
# picked up by jellyfin-permissions.timer.

set -uo pipefail

WATCH_PATHS=(
{% for path in jellyfin_media_paths %}
    "{{ path }}"
{% endfor %}
)

# create/moved_to only: chown raises attrib events, so this never triggers itself.
inotifywait -m -r -q -e create,moved_to --format '%w%f' "${WATCH_PATHS[@]}" |
    while IFS= read -r path; do
        # Files not owned by root (Jellyfin's own output) need nothing; bash's -O
        # checks that without forking. Directories always get swept.
        [ -d "$path" ] || [ -O "$path" ] || continue
        /usr/local/bin/jellyfin-set-permissions.sh "$path"
    done
