# Only the break-glass Django admin is gated; /api stays open for app tokens.
http://paperless.{$BASE_DOMAIN}:8080 {
	@admin path /admin /admin/* /outpost.goauthentik.io/*
	handle @admin {
		import proxy_auth paperless.lan:8000
	}
	handle {
		import proxy paperless.lan:8000
	}
}
http://radicale.{$BASE_DOMAIN}:8080 {
	import proxy radicale.lan:5232
}
http://searxng.{$BASE_DOMAIN}:8080 {
	import proxy_auth searxng.lan:8080
}

http://authentik.{$BASE_DOMAIN}:8080 {
	import proxy_tls authentik.lan:9443
}
http://pihole.{$BASE_DOMAIN}:8080 {
	import proxy_tls_auth pihole.lan:443
}

# Vaultwarden is deliberately not a one-liner: only /admin is gated, the rest of
# the vault stays open. /outpost.goauthentik.io/* must be gated too — forward_auth
# redirects there, and the authentik snippet only serves it inside the handle that
# imports it.
http://vaultwarden.{$BASE_DOMAIN}:8080 {
	@admin path /admin /admin/* /outpost.goauthentik.io/*
	handle @admin {
		import proxy_auth vaultwarden.lan:80
	}
	handle {
		import proxy vaultwarden.lan:80
	}
}

# Catch-all for names the wildcard accepted but that map to no service. Note bots
# never reach this: Anubis challenges them first. This is for humans who mistype.
http://:8080 {
	handle {
		# respond defaults to text/plain, which makes browsers show the markup
		# as source rather than rendering it.
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>404 — no such service</title>
			<style>
			:root { color-scheme: dark light }
			body { margin:0; min-height:100vh; display:grid; place-items:center;
			       font:16px/1.6 system-ui, sans-serif; background:#14161a; color:#e6e8eb }
			main { text-align:center; padding:2rem }
			h1 { font-size:4rem; margin:0; letter-spacing:-.03em }
			p { color:#9aa3ad; margin:.5rem 0 1.5rem }
			code { background:#20242b; padding:.15em .4em; border-radius:4px; color:#e6e8eb }
			a { color:#7aa2f7; text-decoration:none }
			a:hover { text-decoration:underline }
			</style>
			</head>
			<body><main>
			<h1>404</h1>
			<p>No service is published at <code>{host}</code>.</p>
			<p><a href="https://{$BASE_DOMAIN}/">Go to the dashboard</a></p>
			</main></body>
			</html>
			HTML 404
	}
}

# ── Status listener: Homepage's tiles ask here ──────────────────────────────────
# Caddy is in every zone, so it checks the backends Homepage can't reach. Only
# Homepage may ask. The status routes sit inside the
# Homepage-only handle: as siblings, their path matchers would sort ahead of it.
http://:8081 {
	@homepage remote_ip {$HOMEPAGE_IP}
	handle @homepage {
		handle /status/caddy {
			respond 200
		}
		import status anubis http://anubis.lan:9090 /healthz
		import status_tls authentik https://authentik.lan:9443 /-/health/live/
		import status backrest http://backrest.lan:9898 /
		import status dawarich http://dawarich.lan:3000 /api/v1/health
		import status docs http://docs.lan:8349 /
		import status dockge http://dockge.lan:5001 /
		import status dockhand http://dockhand.lan:3000 /
		import status forgejo http://forgejo.lan:3000 /api/healthz
		import status immich http://immich.lan:2283 /api/server/ping
		import status jellyfin http://jellyfin.lan:8096 /health
		import status linkwarden http://linkwarden.lan:3000 /
		import status llamacpp http://llamacpp.lan:8080 /health
		import status openwebui http://openwebui.lan:3000 /health
		import status paperless http://paperless.lan:8000 /
		import status photon http://photon.lan:2322 /status
		import status_tls pihole https://pihole.lan:443 /admin/
		import status radicale http://radicale.lan:5232 /
		import status searxng http://searxng.lan:8080 /healthz
		import status vaultwarden http://vaultwarden.lan:80 /alive
		handle {
			respond 404
		}
	}
	handle {
		abort
	}
}
