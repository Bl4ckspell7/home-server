# Vaultwarden is deliberately not a one-liner: only /admin is gated, the rest of
# the vault stays open. /outpost.goauthentik.io/* must be gated too — forward_auth
# redirects there, and the authentik snippet only serves it inside the handle that
# imports it.
http://vaultwarden.{$BASE_DOMAIN}:8080 {
	@admin path /admin /admin/* /outpost.goauthentik.io/*
	handle @admin {
		import proxy_auth vaultwarden.lan:80
	}
	handle {
		import proxy vaultwarden.lan:80
	}
}

# Catch-all for names the wildcard accepted but that map to no service. Note bots
# never reach this: Anubis challenges them first. This is for humans who mistype.
http://:8080 {
	handle {
		# respond defaults to text/plain, which makes browsers show the markup
		# as source rather than rendering it.
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>404 — no such service</title>
			<style>
			:root { color-scheme: dark light }
			body { margin:0; min-height:100vh; display:grid; place-items:center;
			       font:16px/1.6 system-ui, sans-serif; background:#14161a; color:#e6e8eb }
			main { text-align:center; padding:2rem }
			h1 { font-size:4rem; margin:0; letter-spacing:-.03em }
			p { color:#9aa3ad; margin:.5rem 0 1.5rem }
			code { background:#20242b; padding:.15em .4em; border-radius:4px; color:#e6e8eb }
			a { color:#7aa2f7; text-decoration:none }
			a:hover { text-decoration:underline }
			</style>
			</head>
			<body><main>
			<h1>404</h1>
			<p>No service is published at <code>{host}</code>.</p>
			<p><a href="https://{$BASE_DOMAIN}/">Go to the dashboard</a></p>
			</main></body>
			</html>
			HTML 404
	}
}
