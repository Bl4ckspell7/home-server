{
	# Enable automatic HTTPS
	email bl4ckspell@proton.me # Replace with your email for Let's Encrypt

	# Everything from the internet arrives over the WireGuard tunnel, so without
	# this every request looks like it came from 10.10.0.1 and {client_ip} is just
	# an alias for {remote_host}. Trusting only the VPS end of the tunnel lets
	# {client_ip} resolve from the X-Forwarded-For the VPS stamps, and nothing
	# else can influence it. LAN-direct hits keep their own remote_host.
	servers {
		trusted_proxies static 10.10.0.1/32
	}
}

(error_page) {
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

(authentik) {
	route {
		reverse_proxy /outpost.goauthentik.io/* https://authentik.lan:9443 {
			header_up Host {upstream_hostport}
			trusted_proxies {$ANUBIS_IP}/32
			transport http {
				tls_insecure_skip_verify
			}
		}
		forward_auth https://authentik.lan:9443 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			# Anubis only: any other private source could forge X-Forwarded-Host
			# (which app's policy applies) or X-Forwarded-For.
			trusted_proxies {$ANUBIS_IP}/32
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# Only Anubis may reach :8080: anything else in a zone with Caddy would skip the
# challenge and could forge X-Real-Ip/X-Forwarded-*. A handle, not a bare abort:
# handle sorts before route and reverse_proxy. Every :8080 site gets it through
# proxy/proxy_tls, so a site with its own reverse_proxy must import it too.
(from_anubis) {
	@not_anubis not remote_ip {$ANUBIS_IP}
	handle @not_anubis {
		abort
	}
}

# Backend snippets. {args[0]} is the upstream host:port -- Caddy substitutes import
# arguments textually, so one line per service is enough below. Trusting Anubis
# keeps the client it puts in X-Forwarded-For instead of replacing it with its IP.
(proxy) {
	import from_anubis
	reverse_proxy http://{args[0]} {
		header_up X-Forwarded-Proto https
		trusted_proxies {$ANUBIS_IP}/32
	}
}

# Backends serving their own self-signed cert.
(proxy_tls) {
	import from_anubis
	reverse_proxy https://{args[0]} {
		header_up X-Forwarded-Proto https
		trusted_proxies {$ANUBIS_IP}/32
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Gated behind Authentik SSO.
(proxy_auth) {
	import authentik
	import proxy {args[0]}
}

(proxy_tls_auth) {
	import authentik
	import proxy_tls {args[0]}
}

# Status check for one Homepage tile: {args[0]} name, {args[1]} upstream, {args[2]}
# health path. Only the backend's status code goes back, never its body or headers.
(status) {
	handle /status/{args[0]} {
		rewrite * {args[2]}
		reverse_proxy {args[1]} {
			# a hung backend shows as down (504) instead of an endless spinner
			transport http {
				response_header_timeout 10s
			}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

(status_tls) {
	handle /status/{args[0]} {
		rewrite * {args[2]}
		reverse_proxy {args[1]} {
			transport http {
				response_header_timeout 10s
				tls_insecure_skip_verify
			}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

# Public entrypoint, protected by Anubis. Wildcard: the VPS front-door already
# restricts which names get a certificate, and unmatched names fall through to the
# 404 at the bottom of this file -- so adding a service never touches this block.
*.{$BASE_DOMAIN}, {$BASE_DOMAIN} {
	import error_page
	# Self-signed cert: this listener is only reached via the VPS front-door over
	# WireGuard (which proxies with tls_insecure_skip_verify). No public ACME —
	# home can't validate challenges anymore, they land on the VPS.
	tls internal
	reverse_proxy http://anubis.lan:3000 {
		# {client_ip}, not {remote_host}: at this hop remote_host is the tunnel.
		# Anubis reads X-Real-Ip, and passes it through to the :8080 listener and
		# on to the backends, so this one line fixes the whole chain.
		header_up X-Real-Ip {client_ip}
		header_up X-Http-Version {http.request.proto}
	}
}

# ── Internal listener: Anubis proxies here, and these blocks route by Host ──────
# Caddy sorts host-matched sites ahead of the host-less catch-all, so order within
# this file does not matter.

http://{$BASE_DOMAIN}:8080 {
	import proxy homepage.lan:3000
}
http://homepage.{$BASE_DOMAIN}:8080 {
	import proxy homepage.lan:3000
}
http://backrest.{$BASE_DOMAIN}:8080 {
	import proxy_auth backrest.lan:9898
}
http://dawarich.{$BASE_DOMAIN}:8080 {
	import proxy dawarich.lan:3000
