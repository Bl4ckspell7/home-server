{
	# Enable automatic HTTPS
	email bl4ckspell@proton.me # Replace with your email for Let's Encrypt

	# Everything from the internet arrives over the WireGuard tunnel, so without
	# this every request looks like it came from 10.10.0.1 and {client_ip} is just
	# an alias for {remote_host}. Trusting only the VPS end of the tunnel lets
	# {client_ip} resolve from the X-Forwarded-For the VPS stamps, and nothing
	# else can influence it. LAN-direct hits keep their own remote_host.
	servers {
		trusted_proxies static 10.10.0.1/32
	}
}

(error_page) {
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

(authentik) {
	route {
		reverse_proxy /outpost.goauthentik.io/* https://authentik.lan:9443 {
			header_up Host {upstream_hostport}
			transport http {
				tls_insecure_skip_verify
			}
		}
		forward_auth https://authentik.lan:9443 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# Protected by Anubis
{$BASE_DOMAIN},
authentik.{$BASE_DOMAIN},
backrest.{$BASE_DOMAIN},
cup.{$BASE_DOMAIN},
dawarich.{$BASE_DOMAIN},
docs.{$BASE_DOMAIN},
dockge.{$BASE_DOMAIN},
dockhand.{$BASE_DOMAIN},
forgejo.{$BASE_DOMAIN},
homepage.{$BASE_DOMAIN},
immich.{$BASE_DOMAIN},
jellyfin.{$BASE_DOMAIN},
kuma.{$BASE_DOMAIN},
linkwarden.{$BASE_DOMAIN},
paperless.{$BASE_DOMAIN},
pihole.{$BASE_DOMAIN},
radicale.{$BASE_DOMAIN},
vaultwarden.{$BASE_DOMAIN} {
	import error_page
	# Self-signed cert: this listener is only reached via the VPS front-door over
	# WireGuard (which proxies with tls_insecure_skip_verify). No public ACME —
	# home can't validate challenges anymore, they land on the VPS.
	tls internal
	reverse_proxy http://anubis.lan:3000 {
		# {client_ip}, not {remote_host}: at this hop remote_host is the tunnel.
		# Anubis reads X-Real-Ip, and passes it through to the :8080 listener and
		# on to the backends, so this one line fixes the whole chain.
		header_up X-Real-Ip {client_ip}
		header_up X-Http-Version {http.request.proto}
	}
}

# Internal listener for Anubis backend routing
