PG_PASS={{ pg_pass }}
AUTHENTIK_SECRET_KEY={{ secret_key }}
AUTHENTIK_ERROR_REPORTING__ENABLED=true
AUTHENTIK_OUTPOSTS__DISCOVER=false

# OIDC client credentials for the blueprint's !Env lookups (templates/apps.yaml.j2).
# Set explicitly so recreating a provider keeps the credentials the consuming app
# already has configured.
{% for app in authentik_oidc_apps %}
{% set key = app.slug | replace('-', '_') %}
AUTHENTIK_OIDC_{{ key | upper }}_CLIENT_ID={{ lookup('ansible.builtin.vars', 'oidc_' ~ key ~ '_client_id') }}
AUTHENTIK_OIDC_{{ key | upper }}_CLIENT_SECRET={{ lookup('ansible.builtin.vars', 'oidc_' ~ key ~ '_client_secret') }}
{% endfor %}
