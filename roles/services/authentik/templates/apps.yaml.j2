{{ ansible_managed | comment }}
# Every Authentik application and provider, rendered from the catalog in
# roles/services/authentik/defaults/main.yml. Source of truth is that file, not
# the UI.
#
# Deliberately ONE blueprint: ordering is only guaranteed within a single file,
# and two things depend on it.
#   1. The tombstones must run BEFORE the providers that replace them, because
#      client_id is unique and the replacements reuse the existing credentials.
#   2. The embedded outpost's provider list is replaced wholesale, so every
#      forward-auth provider must be emitted together.
{% macro access_binding(app) %}
{% if app.access_group is defined %}
  # Declared here too: blueprint files apply in no fixed order. No attrs, so
  # the users blueprint keeps owning the group's settings.
  - model: authentik_core.group
    id: {{ app.slug }}-access-group
    identifiers:
      name: {{ app.access_group | to_json }}

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf {{ app.slug }}-app
      order: 0
    attrs:
      group: !KeyOf {{ app.slug }}-access-group

{% endif %}
{% endmacro %}
version: 1
metadata:
  name: home-server-apps
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:

  # ── Tombstones ────────────────────────────────────────────────────────────
  # These run FIRST, not last. client_id carries a unique constraint, and the new
  # providers below deliberately reuse the existing credentials — so the old
  # provider must be gone before its replacement can be created, otherwise the
  # whole blueprint fails validation with "Client ID already exists".
  #
  # Applications first, then the providers they reference. An application whose
  # provider is deleted simply loses the link (it is not itself deleted), and the
  # entries below immediately repoint it.
{% for slug in authentik_removed_apps %}
  - model: authentik_core.application
    state: absent
    identifiers:
      slug: {{ slug }}
{% endfor %}
{% for name in authentik_removed_oauth2_providers %}
  - model: authentik_providers_oauth2.oauth2provider
    state: absent
    identifiers:
      name: {{ name | to_json }}
{% endfor %}
{% for name in authentik_removed_proxy_providers %}
  - model: authentik_providers_proxy.proxyprovider
    state: absent
    identifiers:
      name: {{ name | to_json }}
{% endfor %}
{% for name in authentik_removed_docker_service_connections %}
  # Deleting the connection also clears the outpost's nullable foreign key.
  - model: authentik_outposts.dockerserviceconnection
    state: absent
    identifiers:
      name: {{ name | to_json }}
{% endfor %}

  # ── OIDC providers + applications ─────────────────────────────────────────
{% for app in authentik_oidc_apps %}
{% set host = app.host | default(app.slug ~ '.' ~ authentik_domain) %}
{% set key = app.slug | replace('-', '_') | upper %}
{% for sm in app.scope_mappings | default([]) %}
  - model: authentik_providers_oauth2.scopemapping
    id: {{ app.slug }}-scope-{{ sm.scope_name }}
    identifiers:
      name: {{ (app.name ~ ': ' ~ sm.scope_name) | to_json }}
    attrs:
      name: {{ (app.name ~ ': ' ~ sm.scope_name) | to_json }}
      scope_name: {{ sm.scope_name | to_json }}
      description: {{ sm.description | to_json }}
      expression: {{ sm.expression | to_json }}

{% endfor %}
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ app.slug }}-provider
    identifiers:
      name: {{ app.name | to_json }}
    attrs:
      name: {{ app.name | to_json }}
      client_type: confidential
      grant_types:
{% for g in app.grant_types | default(authentik_oidc_grant_types) %}
        - {{ g | to_json }}
{% endfor %}
      client_id: !Env AUTHENTIK_OIDC_{{ key }}_CLIENT_ID
      client_secret: !Env AUTHENTIK_OIDC_{{ key }}_CLIENT_SECRET
      sub_mode: hashed_user_id
      authorization_flow:
        !Find [
          authentik_flows.flow,
          [slug, default-provider-authorization-implicit-consent],
        ]
      invalidation_flow:
        !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key:
        !Find [
          authentik_crypto.certificatekeypair,
          [name, authentik Self-signed Certificate],
        ]
      redirect_uris:
{% for uri in app.redirect_uris %}
        - matching_mode: strict
          url: {{ uri | to_json }}
{% endfor %}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
{% for sm in app.scope_mappings | default([]) %}
        - !KeyOf {{ app.slug }}-scope-{{ sm.scope_name }}
{% endfor %}

  - model: authentik_core.application
    id: {{ app.slug }}-app
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name | to_json }}
      slug: {{ app.slug }}
      group: {{ app.group | default('Public') | to_json }}
      icon: {{ app.icon | default('application-icons/' ~ app.slug ~ '.svg') | to_json }}
      provider: !KeyOf {{ app.slug }}-provider
      meta_launch_url: {{ ('https://' ~ host ~ (app.launch_path | default(''))) | to_json }}
      meta_description: {{ app.description | to_json }}

{{ access_binding(app) }}
{% endfor %}
  # ── Forward-auth (proxy) providers + applications ─────────────────────────
{% for app in authentik_proxy_apps %}
{% set host = app.host | default(app.slug ~ '.' ~ authentik_domain) %}
  - model: authentik_providers_proxy.proxyprovider
    id: {{ app.slug }}-provider
    identifiers:
      name: {{ app.slug }}
    attrs:
      name: {{ app.slug }}
      mode: forward_single
      grant_types:
{% for g in app.grant_types | default(authentik_proxy_grant_types) %}
        - {{ g | to_json }}
{% endfor %}
      external_host: https://{{ host }}
      authorization_flow:
        !Find [
          authentik_flows.flow,
          [slug, default-provider-authorization-implicit-consent],
        ]
      invalidation_flow:
        !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]

  - model: authentik_core.application
    id: {{ app.slug }}-app
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name | to_json }}
      slug: {{ app.slug }}
      group: {{ app.group | default('Public') | to_json }}
      icon: {{ app.icon | default('application-icons/' ~ app.slug ~ '.svg') | to_json }}
      provider: !KeyOf {{ app.slug }}-provider
{# blank://blank hides the tile (Authentik convention). #}
      meta_launch_url: {{ ('blank://blank' if app.hidden | default(false) else 'https://' ~ host ~ (app.launch_path | default(''))) | to_json }}
      meta_description: {{ app.description | to_json }}

{{ access_binding(app) }}
{% endfor %}
  # ── Launcher tiles (no provider) ──────────────────────────────────────────
{% for app in authentik_link_apps %}
{% set host = app.host | default(app.slug ~ '.' ~ authentik_domain) %}
  - model: authentik_core.application
    id: {{ app.slug }}-app
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name | to_json }}
      slug: {{ app.slug }}
      group: {{ app.group | default('Public') | to_json }}
      icon: {{ app.icon | default('application-icons/' ~ app.slug ~ '.svg') | to_json }}
      meta_launch_url: {{ ('https://' ~ host ~ (app.launch_path | default(''))) | to_json }}
      meta_description: {{ app.description | to_json }}

{% endfor %}
  # ── Embedded outpost ──────────────────────────────────────────────────────
  # authentik_host builds the /application/o/authorize/ URL that Caddy's
  # forward_auth redirects users to. It is NOT the provider's external_host, and
  # nothing else in this repo sets it — leaving it unmanaged is why the domain
  # migration left every gated app pointing at the old hostname.
  #
  # _config is replaced wholesale, so the non-host keys are restated at their
  # current live values rather than being silently reset to defaults.
  - model: authentik_outposts.outpost
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      providers:
{% for app in authentik_proxy_apps %}
        - !KeyOf {{ app.slug }}-provider
{% endfor %}
      config:
        authentik_host: https://authentik.{{ authentik_domain }}
        authentik_host_browser: https://authentik.{{ authentik_domain }}
        authentik_host_insecure: false
        log_level: info
        object_naming_template: ak-outpost-%(name)s
