[Unit]
Description=ddns-updater (points the domain at the VPS public IP)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/qdm12/ddns-updater:v2.10.0@sha256:3e2aa558946b5a293def4d73008fa4651c072b2c12932cecd02126fb23979831
User=1000:1000
Volume=/opt/ddns-updater/data:/updater/data:Z
Environment=CONFIG_FILEPATH=/updater/data/config.json
Environment=PERIOD=15m
Environment=PUBLICIP_FETCHERS=all
Environment=SERVER_ENABLED=false
Environment=TZ=Europe/Berlin
Environment=LOG_LEVEL=info

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
