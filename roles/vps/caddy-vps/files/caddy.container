[Unit]
Description=Caddy front-door (reverse proxy + landing fallback)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2.11.9@sha256:0c2243efcf437ab7f7a978f1027fcf0d4f9be8a75df27b1b3fbc5dbe0ffa8cf0
# BASE_DOMAIN + VPS_IP for the {$VAR} placeholders in the Caddyfile. Written by
# Ansible (roles/vps/caddy-vps) so the VPS IP never lands in git.
EnvironmentFile=/etc/caddy-vps.env
PublishPort=80:80
PublishPort=443:443/tcp
PublishPort=443:443/udp
Volume=/opt/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/srv/landing:/srv/landing:ro,Z
Volume=/var/log/caddy:/var/log/caddy:Z
Volume=caddy-data:/data
Volume=caddy-config:/config

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
